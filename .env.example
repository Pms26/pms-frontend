# OASIS PMS Frontend — Environment Variables
# Copy this file to .env.local and fill in values

# URL du api-gateway (ne jamais pointer directement vers les services individuels)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Active les mocks au lieu des vrais appels API (true | false)
# Mettre à false quand le api-gateway est opérationnel
NEXT_PUBLIC_USE_MOCKS=true
